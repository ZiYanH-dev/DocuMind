# ===== 应用 =====
APP_NAME=DocuMind
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ===== 数据库（分字段，URL 由 settings 拼接）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ai_learning
POSTGRES_PASSWORD=ai_learning_123
POSTGRES_DB=ai_learning

# ===== Redis（分字段）=====
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# ===== CORS（由 FRONTEND_PORT 自动派生，无需写 CORS_ORIGINS；需额外域名再覆盖）=====
# CORS_ORIGINS=http://localhost:3000

LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://your-provider.com/compatible-mode/v1
LLM_MODEL=qwen-max

# 或 DeepSeek（兼容 OpenAI 格式）
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 或 Ollama 本地
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# ===== Embedding（本地 Ollama，OpenAI 兼容接口）=====
# 大模型走云端 LLM API、Embedding 用本地 Ollama 时，显式填写（两者 base_url 不同）：
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama


# ===== 文档解析 =====
MAX_UPLOAD_SIZE_MB=50